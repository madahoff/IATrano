# =====================================================================
# IATrano — variables d'environnement
# Copiez ce fichier en .env et renseignez au minimum les valeurs marquées [OBLIGATOIRE].
# =====================================================================

# --- Base de données -------------------------------------------------
# Docker Compose : seul le mot de passe est requis, l'URL est construite automatiquement.
# Utilisez uniquement des lettres et des chiffres (le mot de passe est inséré dans une URL).
# [OBLIGATOIRE en Docker] ex. : openssl rand -hex 24
POSTGRES_PASSWORD=change-me-hex-only
POSTGRES_USER=iatrano
POSTGRES_DB=iatrano

# Développement local (pnpm dev) : URL complète vers PostgreSQL (compose.dev.yaml publie le port 5442).
DATABASE_URL=postgresql://iatrano:iatrano@localhost:5442/iatrano

# --- Sécurité --------------------------------------------------------
# Secret de signature des jetons de session (≥ 32 caractères). [OBLIGATOIRE en production]
#   openssl rand -base64 48
AUTH_SECRET=

# Cookie « Secure » : auto (selon HTTPS / X-Forwarded-Proto), true ou false.
# Laissez « auto » : il fonctionne en http sur le réseau local et en https derrière Dokploy.
COOKIE_SECURE=auto

# Faire confiance à X-Forwarded-For pour l'IP client (limitation de débit). true derrière un reverse proxy.
TRUST_PROXY=false

# Nombre maximal de générations par minute et par utilisateur.
RATE_LIMIT_GENERATIONS_PER_MINUTE=20

# --- Super-administrateur initial -----------------------------------
# Créé au premier démarrage uniquement s'il n'existe encore aucun super-administrateur.
# Les redémarrages ne recréent rien et ne réinitialisent jamais le mot de passe.
# [OBLIGATOIRE]
SUPERADMIN_EMAIL=admin@example.com
# [OBLIGATOIRE] ≥ 12 caractères ; changez-le ensuite dans l'interface
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Super administrateur

# --- Serveur IA (valeurs initiales, modifiables ensuite dans Administration → Serveur IA) ---
# ollama  : Ollama (API native : détection des capacités, Thinking natif)
# openai  : serveur compatible OpenAI (LM Studio, llama.cpp/llama-server, vLLM, LocalAI…)
AI_PROVIDER=ollama
# Adresse vue DEPUIS LE SERVEUR IATrano (pas depuis votre navigateur) :
#   pnpm dev sur la même machine que Ollama  → http://localhost:11434
#   Docker, Ollama sur la machine hôte       → http://host.docker.internal:11434
#   Moteur sur une autre machine du réseau   → http://192.168.1.20:11434
#   LM Studio                                → http://localhost:1234/v1
AI_BASE_URL=http://localhost:11434
# Clé d'API, seulement si votre serveur compatible OpenAI en exige une.
AI_API_KEY=
# Liste blanche facultative des hôtes autorisés pour le serveur IA (séparés par des virgules).
AI_URL_ALLOWLIST=

# --- Recherche Web (valeurs initiales, modifiables dans Administration → Recherche Web) ---
# Fournisseur : searxng (auto-hébergé, inclus dans compose.yaml) ou brave (API Brave Search, clé requise).
SEARCH_PROVIDER=searxng
# Adresse de SearXNG vue DEPUIS LE SERVEUR IATrano (format json activé, voir searxng/settings.yml) :
#   Docker Compose (service inclus)  → http://searxng:8080
#   pnpm dev + compose.dev.yaml      → http://localhost:8888
#   SearXNG sur le serveur (Tailscale, voir deploy/searxng/README.md) → http://100.121.17.90:8888
SEARXNG_URL=http://searxng:8080
# [OBLIGATOIRE en Docker] secret interne de SearXNG : openssl rand -hex 32
SEARXNG_SECRET=
# Image SearXNG (épinglez une version précise en production, ex. searxng/searxng:2025.10.18-xxxxxxx).
SEARXNG_IMAGE=searxng/searxng:latest
# Clé de l'API Brave Search (https://api.search.brave.com) : moteur principal si SEARCH_PROVIDER=brave,
# sinon moteur de SECOURS utilisé automatiquement quand SearXNG échoue (désactivable dans l'administration).
BRAVE_SEARCH_API_KEY=

# --- JEV : décisions oui/non (valeurs initiales, modifiables dans Administration → Connexion JEV) ---
# Serveur jevos (voir deploy/jev/README.md). Adresse vue DEPUIS LE SERVEUR IATrano (ici via Tailscale).
JEV_HOST=100.121.17.90
JEV_PORT=8017
# http ou https
JEV_PROTOCOL=http
# Même valeur que JEV_API_KEY dans /etc/jev/jev.env sur le serveur JEV : openssl rand -hex 32
# Utilisée seulement tant qu'aucune clé n'est enregistrée dans l'administration (celle-ci est chiffrée en base).
JEV_API_KEY=
# Délai d'attente des appels à JEV, en secondes.
JEV_TIMEOUT_SEC=10

# --- Bibliothèque documentaire (valeurs initiales, modifiables dans Administration → Documents) ---
# Dossier des fichiers importés et de leurs dérivés (pages rendues, images clés, audio). Docker : volume /app/data.
DOCUMENT_STORAGE_DIR=
# Modèle d'embeddings (recherche sémantique), servi par le même serveur IA. Vide : recherche lexicale seule.
#   ollama pull embeddinggemma   (multilingue, ≈ 620 Mo)
DOCUMENT_EMBEDDING_MODEL=embeddinggemma
# Service de transcription compatible OpenAI (voir deploy/whisper/README.md). Vide : audio des vidéos non transcrit.
#   pnpm dev → http://127.0.0.1:8090    Docker → http://host.docker.internal:8090
DOCUMENT_TRANSCRIPTION_URL=
DOCUMENT_TRANSCRIPTION_MODEL=small
# Modèle vision-langage pour les schémas et graphiques (ex. qwen2.5vl:7b). Vide : OCR seul (signalé à l'utilisateur).
DOCUMENT_VISION_MODEL=
# off : ce processus ne traite pas la file des documents (ex. instance secondaire).
DOCUMENT_WORKER=

# --- Docker Compose : exposition de l'application --------------------
# Port de la machine hôte sur lequel l'application est publiée (et interface d'écoute).
APP_PORT=3000
APP_BIND=0.0.0.0
