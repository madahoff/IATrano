# =====================================================================================================
# IATrano — variables de PRODUCTION (Dokploy, service Compose « iatrano », fichier compose.yaml)
#
# Où les mettre : Dokploy → projet → service Compose → onglet « Environment ». Dokploy les écrit dans un
# fichier .env à côté de compose.yaml ; compose.yaml les transmet ensuite à chaque conteneur.
# Ne commitez JAMAIS ce fichier une fois rempli (.gitignore exclut .env*), et ne l'intégrez pas à une image.
#
# Contrôle avant déploiement (sur le PC de développement ou le serveur, n'affiche aucun secret) :
#   node scripts/check-env.mjs chemin/vers/le/.env
#
# Légende : [OBLIGATOIRE]  [À ADAPTER] (dépend de votre infrastructure)  [FACULTATIF]
# Toutes ces variables sont lues À L'EXÉCUTION (aucune n'est figée dans l'image, sauf la section « Build »).
# Aucune variable n'est exposée au navigateur : l'application n'utilise aucune variable NEXT_PUBLIC_*.
# =====================================================================================================

# --- Base de données (services db, migrate, app) -----------------------------------------------------
# PostgreSQL 17 interne (volume iatrano-db), jamais publié. DATABASE_URL est construite par compose.yaml :
# NE LA DÉFINISSEZ PAS ici.
# [OBLIGATOIRE] lettres et chiffres uniquement (insérée dans l'URL de connexion) :  openssl rand -hex 24
# ⚠ Lue seulement à la CRÉATION du volume : la changer ensuite n'altère pas le mot de passe de la base existante.
POSTGRES_PASSWORD=__A_GENERER__openssl_rand_hex_24
POSTGRES_USER=iatrano
POSTGRES_DB=iatrano

# --- Authentification et sécurité (service app) ------------------------------------------------------
# [OBLIGATOIRE] ≥ 32 caractères :  openssl rand -base64 48
# Signe les sessions ET chiffre les clés stockées en base (clé JEV). Le changer déconnecte tout le monde et
# oblige à ressaisir la clé JEV dans l'administration. Conservez-le dans votre gestionnaire de mots de passe.
AUTH_SECRET=__A_GENERER__openssl_rand_base64_48
# Cookie « Secure » : auto (selon X-Forwarded-Proto), true (recommandé dès que l'accès se fait en HTTPS), false.
# [À ADAPTER] true si vous servez IATrano en https (domaine public ou HTTPS Tailscale), auto sinon.
COOKIE_SECURE=auto
# true : l'IP client est lue dans X-Forwarded-For (Traefik). Sûr car compose.yaml ne publie aucun port de l'app.
TRUST_PROXY=true
# Générations par minute et par utilisateur.
RATE_LIMIT_GENERATIONS_PER_MINUTE=20

# --- Super-administrateur initial (service app) ------------------------------------------------------
# Créé au premier démarrage seulement s'il n'existe aucun super-administrateur ; jamais recréé ni réinitialisé.
# [OBLIGATOIRE] [À ADAPTER]
SUPERADMIN_EMAIL=__VOTRE_EMAIL__
# [OBLIGATOIRE] ≥ 12 caractères :  openssl rand -base64 18   (changez-le ensuite dans Paramètres → Sécurité)
SUPERADMIN_PASSWORD=__A_GENERER__openssl_rand_base64_18
SUPERADMIN_NAME=Super administrateur

# --- Serveur IA (service app ; valeur initiale, modifiable ensuite dans Administration → Serveur IA) ---
AI_PROVIDER=ollama
# Adresse vue DEPUIS LE CONTENEUR app (jamais localhost). Vérifié le 2026-10-24 : Ollama 0.40.6 répond sur
# l'IP Tailscale du serveur (qwen3:32b, embeddinggemma). [À ADAPTER] deux choix possibles sur le serveur Dokploy :
#   http://100.121.17.90:11434        IP Tailscale de la machine (fonctionne si Ollama écoute sur 0.0.0.0 ou sur cette IP)
#   http://host.docker.internal:11434 seulement si Ollama écoute sur 0.0.0.0 (OLLAMA_HOST=0.0.0.0:11434)
# Contrôle depuis le serveur : voir docs/DEPLOIEMENT.md, étape « Vérifier les dépendances depuis le conteneur ».
AI_BASE_URL=http://100.121.17.90:11434
# [FACULTATIF] clé d'API, seulement pour un serveur compatible OpenAI qui en exige une. Ollama : vide.
AI_API_KEY=
# [FACULTATIF] liste blanche des hôtes autorisés pour le serveur IA (l'administration ne pourra pas en sortir).
AI_URL_ALLOWLIST=

# --- Recherche Web (services app et searxng) ---------------------------------------------------------
SEARCH_PROVIDER=searxng
# Service SearXNG interne de compose.yaml (nom DNS Docker). Ne pas modifier sauf SearXNG externe.
SEARXNG_URL=http://searxng:8080
# [OBLIGATOIRE] :  openssl rand -hex 32
SEARXNG_SECRET=__A_GENERER__openssl_rand_hex_32
# Version épinglée (Docker Hub, 2026-10-23). Mettez-la à jour volontairement.
SEARXNG_IMAGE=searxng/searxng:2026.10.23-629368e40
# [FACULTATIF] clé API Brave Search (https://api.search.brave.com) : moteur de secours si SearXNG échoue,
# ou moteur principal si SEARCH_PROVIDER=brave (elle devient alors obligatoire). Vide : pas de secours.
BRAVE_SEARCH_API_KEY=

# --- JEV : décisions oui/non (service app ; modifiable dans Administration → Connexion JEV) -------------
# Vérifié le 2026-10-24 : JEV répond sur 100.121.17.90:8017 (/health : ready, modèle jevos-v5) et EXIGE une clé API.
# [À ADAPTER] même logique que AI_BASE_URL : IP Tailscale, ou host.docker.internal si JEV écoute sur 0.0.0.0.
JEV_HOST=100.121.17.90
JEV_PORT=8017
JEV_PROTOCOL=http
# [OBLIGATOIRE pour le routage JEV] même valeur que JEV_API_KEY dans /etc/jev/jev.env sur le serveur
# (voir deploy/jev/README.md) — à recopier, PAS à régénérer. Sans clé, le chat fonctionne mais sans routage JEV
# (repli : réponse simple). Une clé saisie dans Administration → Connexion JEV (chiffrée en base) a priorité.
JEV_API_KEY=
JEV_TIMEOUT_SEC=10

# --- Bibliothèque documentaire (service app ; valeurs initiales, modifiables dans Administration → Documents)
# Lues UNE SEULE FOIS, à la création des réglages en base (premier démarrage). Ensuite : l'administration fait foi.
# Modèle d'embeddings servi par le même Ollama (installé sur le serveur, vérifié le 2026-10-24).
DOCUMENT_EMBEDDING_MODEL=embeddinggemma
# [FACULTATIF] service de transcription compatible OpenAI (deploy/whisper). Non détecté sur le serveur :
# vide = l'audio des vidéos n'est pas transcrit (signalé à l'utilisateur). Si installé sur l'hôte :
#   http://host.docker.internal:8090  (le service doit écouter sur 0.0.0.0, pas 127.0.0.1)
DOCUMENT_TRANSCRIPTION_URL=
DOCUMENT_TRANSCRIPTION_MODEL=small
# [FACULTATIF] modèle vision-langage (ex. qwen2.5vl:7b, à installer dans Ollama). Vide : OCR seul.
DOCUMENT_VISION_MODEL=
# Vide : ce conteneur traite la file des documents. « off » seulement pour une instance secondaire.
DOCUMENT_WORKER=

# --- Ressources (compose.yaml) -----------------------------------------------------------------------
# Limites par conteneur, pour préserver les autres applications du serveur (Ollama/qwen3:32b surtout).
# À ajuster après observation (docker stats) : l'OCR et le rendu de gros PDF sont les pics de l'app.
APP_MEMORY_LIMIT=4g
APP_CPU_LIMIT=4
DB_MEMORY_LIMIT=2g
# Tas V8 de Node, à garder nettement sous APP_MEMORY_LIMIT.
NODE_OPTIONS=--max-old-space-size=2048

# --- Build des images (lues par Docker au moment du build) ---------------------------------------------
NODE_VERSION=22.23.4-alpine
# ffmpeg (vidéos/audio, ≈ 70 Mo) et tesseract natif (OCR fra+eng, ≈ 30 Mo) dans l'image.
WITH_FFMPEG=true
WITH_TESSERACT=true
