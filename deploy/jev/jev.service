# Service systemd de JEV (jevos). Gabarit : install.sh remplace les @VARIABLES@
# puis l'installe dans /etc/systemd/system/jev.service.
[Unit]
Description=JEV - serveur de décisions oui/non (jevos)
Documentation=https://github.com/feder-cr/jev
# Le service écoute sur l'IP Tailscale : il doit démarrer après Tailscale.
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service

[Service]
Type=simple
User=@JEV_USER@
Group=@JEV_USER@
WorkingDirectory=@JEV_DIR@
# JEV_API_KEY=... (fichier root:root, droits 600, lu par systemd avant de changer d'utilisateur)
EnvironmentFile=/etc/jev/jev.env
Environment=UV_CACHE_DIR=@JEV_DIR@/.cache/uv
Environment=HOME=@JEV_DIR@
# Attend que l'IP Tailscale soit attribuée (sinon l'écoute sur @JEV_HOST@ échoue au démarrage).
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do ip -4 -o addr show | grep -q " @JEV_HOST@/" && exit 0; sleep 2; done; echo "IP Tailscale @JEV_HOST@ absente" >&2; exit 1'
# --no-sync : aucun accès réseau au démarrage (les dépendances sont installées par install.sh).
ExecStart=/usr/local/bin/uv run --no-sync jev serve --gguf @JEV_GGUF@ --device cpu --threads @JEV_THREADS@ --host @JEV_HOST@ --port @JEV_PORT@
Restart=on-failure
RestartSec=5
TimeoutStartSec=180

# Durcissement
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@JEV_DIR@
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
