# Variables du service SearXNG (Dokploy : onglet « Environment » ; en direct : copiez en .env).
# Secret interne : openssl rand -hex 32
SEARXNG_SECRET=
# Adresse et port d'écoute : l'IP Tailscale du serveur, jamais 0.0.0.0.
SEARXNG_HOST=100.121.17.90
SEARXNG_PORT=8888
# Épinglez une version précise en production.
SEARXNG_IMAGE=searxng/searxng:latest
# Hors Dokploy : SEARXNG_SETTINGS=./settings.yml
